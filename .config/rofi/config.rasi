configuration {
    modi: "drun,run,window";
    font: "JetBrains Mono 12";
    show-icons: true;
    icon-theme: "hicolor";
}

@theme "/dev/null"

* {
    background-color:   #000000;
    text-color:         #FFFFFF;
    border-color:       #FFFFFF;
    
    margin:             0;
    padding:            0;
    spacing:            0;
}

window {
    background-color:   #000000;
    border:             1px;
    border-color:       #FFFFFF;
    border-radius:      0px;
    width:              600px;
    padding:            20px;
}

mainbox {
    background-color:   #000000;
    children:           [ inputbar, listview ];
    spacing:            15px;
}

inputbar {
    background-color:   #000000;
    border:             1px;
    border-color:       #FFFFFF;
    padding:            8px 12px;
    children:           [ prompt, entry ];
    spacing:            10px;
}

prompt {
    background-color:   #000000;
    text-color:         #FFFFFF;
}

entry {
    background-color:   #000000;
    text-color:         #FFFFFF;
    placeholder:        "Search...";
    placeholder-color:  #888888;
}

listview {
    background-color:   #000000;
    lines:              8;
    columns:            1;
    spacing:            5px;
}

element {
    background-color:   #000000;
    text-color:         #FFFFFF;
    padding:            8px 10px;
    spacing:            12px;
}

element selected {
    background-color:   #FFFFFF;
    text-color:         #000000;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
}

element-icon {
    background-color:   transparent;
    size:               20px;
}
